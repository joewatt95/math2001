example : 34 ≡ 104 [ZMOD 5] := by
  show ∃ k, (34:ℤ) - 104 = 5 * k
  use -14
  numbers

theorem Int.ModEq.symm (h : a ≡ b [ZMOD n]) : b ≡ a [ZMOD n] := by
  obtain ⟨x, hx : a - b = n * x⟩ := h
  show ∃ k, b - a = n * k
  use -x
  calc
    b - a = -(a - b) := by ring
    _ = -(n * x) := by rw [hx]
    _ = n * -x := by ring

theorem Int.ModEq.trans (h1 : a ≡ b [ZMOD n]) (h2 : b ≡ c [ZMOD n]) :
    a ≡ c [ZMOD n] := by
  obtain ⟨x, hx : a - b = n * x⟩ := h1
  obtain ⟨y, hy : b - c = n * y⟩ := h2
  show ∃ k, a - c = n * k
  use x + y
  calc
    a - c = a - b + (b - c) := by ring
    _ = n * x + n * y := by rw [hx, hy]
    _ = n * (x + y) := by ring

example : a + n * c ≡ a [ZMOD n] := by
  show ∃ k, a + n * c - a = n * k
  use c
  ring


example {a b : ℤ} (h : a ≡ b [ZMOD 5]) : 2 * a + 3 ≡ 2 * b + 3 [ZMOD 5] := by
  obtain ⟨x, hx : a - b = 5 * x⟩ := h
  show ∃ k, 2 * a + 3 - (2 * b + 3) = 5 * k
  use 2 * x
  calc
    2 * a + 3 - (2 * b + 3) = 2 * (a - b) := by ring
    _ = 2 * (5 * x) := by rw [hx]
    _ = 5 * (2 * x) := by ring

example {m n : ℤ} (h : m ≡ n [ZMOD 4]) : 3 * m - 1 ≡ 3 * n - 1 [ZMOD 4] := by
  obtain ⟨x, hx : m - n = 4 * x⟩ := h
  show ∃ k, 3 * m - 1 - (3 * n - 1) = 4 * k
  use 3 * x
  calc
    3 * m - 1 - (3 * n - 1) = 3 * (m - n) := by ring
    _ = 3 * (4 * x) := by rw [hx]
    _ = 4 * (3 * x) := by ring

example {k : ℤ} (hb : k ≡ 3 [ZMOD 5]) :
    4 * k + k ^ 3 + 3 ≡ 4 * 3 + 3 ^ 3 + 3 [ZMOD 5] := by
  obtain ⟨x, hx : k - 3 = 5 * x⟩ := hb
  show ∃ m, 4 * k + k ^ 3 + 3 - (4 * 3 + 3 ^ 3 + 3) = 5 * m
  use x * (k ^ 2 + 3 * k + 13)
  calc
    4 * k + k ^ 3 + 3 - (4 * 3 + 3 ^ 3 + 3) = (k - 3) * (k ^ 2 + 3 * k + 13) := by ring
    _ = 5 * x * (k ^ 2 + 3 * k + 13) := by rw [hx]
    _ = 5 * (x * (k ^ 2 + 3 * k + 13)) := by ring
